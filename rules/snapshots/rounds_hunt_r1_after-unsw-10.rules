# AI rules from the hunt condition (profile unsw-v2-hunt). Every rule here passed test_rule before it was saved.
# Goal: Detect D-Link/Planex router auth bypass exploit using xmlset_roodkcableoj28840ybtide User-Agent | Blind spots: none for this exact UA | False positives: no legitimate traffic uses this UA
alert http any any -> $HOME_NET any (msg:"EXPLOIT D-Link DIR-100 auth bypass xmlset_roodkcableoj28840ybtide User-Agent"; flow:to_server,established; http.user_agent; content:"xmlset_roodkcableoj28840ybtide"; nocase; classtype:attempted-admin; sid:7800001; rev:1;)
# Goal: Detect HP OpenView NNM jovgraph.exe displayWidth buffer overflow exploit | Blind spots: other jovgraph.exe overflow parameters | False positives: legitimate HP OpenView NNM jovgraph displayWidth requests with long non-numeric values are rare
alert http any any -> $HOME_NET any (msg:"EXPLOIT HP OpenView NNM jovgraph.exe displayWidth overflow attempt"; flow:to_server,established; http.uri; content:"/OvCgi/jovgraph.exe"; nocase; http.uri; content:"displayWidth+1AAAA"; nocase; classtype:attempted-admin; sid:7800002; rev:1;)
# Goal: Detect HP OpenView NNM nnmRptConfig.exe format string exploit | Blind spots: other long parameter overflows without format specifiers | False positives: legitimate NNM report config requests are not expected to contain Template=A% format specifiers
alert http any any -> $HOME_NET any (msg:"EXPLOIT HP OpenView NNM nnmRptConfig.exe format string attempt"; flow:to_server,established; http.uri; content:"/OvCgi/nnmRptConfig.exe"; nocase; http.uri; content:"Template=A%"; nocase; classtype:attempted-admin; sid:7800003; rev:1;)
# Goal: Detect Cisco Secure ACS CSUserCGI.exe Logout buffer overflow | Blind spots: other CSUserCGI.exe parameters | False positives: legitimate CSUserCGI logout requests do not include long non-numeric arguments
alert http any any -> $HOME_NET any (msg:"EXPLOIT Cisco Secure ACS CSUserCGI.exe Logout overflow attempt"; flow:to_server,established; http.uri; content:"/securecgi-bin/CSUserCGI.exe"; nocase; http.uri; content:"Logout+aaaa"; nocase; classtype:attempted-admin; sid:7800004; rev:1;)
# Goal: Detect access to the vulnerable chetcpasswd.cgi password changer | Blind spots: none for this endpoint | False positives: legitimate use of this old CGI is rare but possible
alert http any any -> $HOME_NET any (msg:"SERVER-WEBAPP chetcpasswd.cgi access"; flow:to_server,established; http.uri; content:"/cgi-bin/chetcpasswd.cgi"; nocase; classtype:web-application-attack; sid:7800005; rev:1;)
# Goal: Detect HP OpenView NNM OvWebHelp.exe Topic buffer overflow | Blind spots: other OvWebHelp parameters | False positives: legitimate OvWebHelp Topic requests with huge Topic values are not normal
alert http any any -> $HOME_NET any (msg:"EXPLOIT HP OpenView NNM OvWebHelp.exe Topic overflow attempt"; flow:to_server,established; http.uri; content:"/OvCgi/OvWebHelp.exe"; nocase; http.uri; content:"Topic="; nocase; http.uri; content:"deadbeef"; nocase; classtype:attempted-admin; sid:7800006; rev:1;)
# Goal: Detect PHP webshell creation through a URL parameter carrying PHP passthru code | Blind spots: other PHP code execution functions | False positives: legitimate web apps do not pass passthru in a newvalue URL parameter
alert http any any -> $HOME_NET any (msg:"SERVER-WEBAPP PHP webshell creation via URL parameter"; flow:to_server,established; http.uri; content:"newvalue="; nocase; http.uri; content:"passthru"; nocase; classtype:web-application-attack; sid:7800007; rev:1;)
# Goal: Detect IIS-style overlong UTF-8 directory traversal (%c0%ae%c0%ae encodes a dot) | Blind spots: other overlong encodings (e.g. %c1%1c) | False positives: legitimate URIs do not carry invalid UTF-8 overlong dot sequences
alert http any any -> $HOME_NET any (msg:"SERVER-WEBAPP Unicode overlong directory traversal attempt"; flow:to_server,established; http.uri.raw; content:"%c0%ae%c0%ae"; nocase; classtype:web-application-attack; sid:7800008; rev:1;)
# Goal: Detect URL-encoded backslash directory traversal (..%5c) in HTTP requests | Blind spots: raw backslash traversal not encoded as %5c | False positives: legitimate clients do not encode ..\ traversal sequences in a URI
alert http any any -> $HOME_NET any (msg:"SERVER-WEBAPP encoded backslash traversal attempt"; flow:to_server,established; http.uri.raw; content:"%2e%2e%5c"; nocase; classtype:web-application-attack; sid:7800009; rev:1;)
# Goal: Detect HTTP URI format-string probes using huge width specifiers (%99999999d/%99999999s) | Blind spots: other format specifier encodings | False positives: legitimate URIs do not contain %99999999 format specifiers
alert http any any -> $HOME_NET any (msg:"SERVER-WEBAPP HTTP URI format string attempt"; flow:to_server,established; http.uri.raw; content:"%99999999"; nocase; classtype:web-application-attack; sid:7800010; rev:1;)
# Goal: Detect phpinfo injection carried in the HTTP User-Agent header | Blind spots: other PHP injection payloads in User-Agent | False positives: no legitimate browser or client identifies itself as phpinfo
alert http any any -> $HOME_NET any (msg:"SERVER-WEBAPP phpinfo in HTTP User-Agent"; flow:to_server,established; http.user_agent; content:"phpinfo"; nocase; classtype:web-application-attack; sid:7800011; rev:1;)
# Goal: Detect reflected/script injection probes carried in the HTTP User-Agent header | Blind spots: other obfuscated XSS payloads in User-Agent | False positives: no legitimate browser or client uses <<ScrIPt in its User-Agent
alert http any any -> $HOME_NET any (msg:"SERVER-WEBAPP XSS in HTTP User-Agent"; flow:to_server,established; http.user_agent; content:"<<ScrIPt"; nocase; classtype:web-application-attack; sid:7800012; rev:1;)
# Goal: Detect URL-encoded triple less-than (<<<) used by encoded XSS/HTML injection probes | Blind spots: XSS payloads without encoded angle brackets | False positives: legitimate URIs do not contain %3c%3c%3c
alert http any any -> $HOME_NET any (msg:"SERVER-WEBAPP encoded XSS in HTTP URI"; flow:to_server,established; http.uri.raw; content:"%3c%3c%3c"; nocase; classtype:web-application-attack; sid:7800013; rev:1;)
# Goal: Detect FTP RETR commands using path traversal (/../) to read files outside the FTP root | Blind spots: traversal with backslashes or no leading slash | False positives: legitimate FTP clients do not RETR absolute /../ paths
alert ftp any any -> $HOME_NET 21 (msg:"FTP RETR path traversal attempt"; flow:to_server,established; content:"RETR /../"; nocase; classtype:attempted-admin; sid:7800014; rev:1;)
# Goal: Detect raw-dot encoded-backslash directory traversal (..%5c) in HTTP requests | Blind spots: fully encoded %2e%2e%5c is handled by a companion rule | False positives: legitimate clients do not encode ..\ traversal sequences in a URI
alert http any any -> $HOME_NET any (msg:"SERVER-WEBAPP encoded backslash traversal attempt raw dots"; flow:to_server,established; http.uri.raw; content:"..%5c"; nocase; classtype:web-application-attack; sid:7800015; rev:1;)
# Goal: Detect FTP commands carrying huge-width printf format specifiers (%99999999d) as login/command arguments | Blind spots: other format string encodings | False positives: legitimate FTP credentials or commands do not contain %99999999
alert ftp any any -> $HOME_NET 21 (msg:"FTP command format string attempt"; flow:to_server,established; content:"%99999999"; nocase; classtype:attempted-admin; sid:7800016; rev:1;)
# Goal: Detect HP HPEinc remote file inclusion | Blind spots: other RFI parameters | False positives: no legitimate /HPE/ HPEinc requests
alert http any any -> $HOME_NET any (msg:"SERVER-WEBAPP HP HPEinc remote file inclusion attempt"; flow:to_server,established; http.uri.raw; content:"/HPE/"; nocase; content:"HPEinc="; nocase; classtype:web-application-attack; sid:7800017; rev:1;)
# Goal: Detect Novell ZENworks UploadServlet WAR upload RCE | Blind spots: other ZENworks upload vectors | False positives: legitimate ZENworks UploadServlet WAR uploads are not normal
alert http any any -> $HOME_NET any (msg:"EXPLOIT Novell ZENworks UploadServlet WAR upload attempt"; flow:to_server,established; http.uri.raw; content:"/zenworks"; nocase; content:"filename"; nocase; content:".war"; nocase; classtype:web-application-attack; sid:7800018; rev:1;)
# Goal: Detect raw HTTP path traversal | Blind spots: encoded traversal variants | False positives: legitimate clients do not send unnormalized /../ in URI
alert http any any -> $HOME_NET any (msg:"SERVER-WEBAPP HTTP path traversal attempt"; flow:to_server,established; http.uri.raw; content:"/../"; nocase; classtype:web-application-attack; sid:7800019; rev:1;)
# Goal: Detect raw XSS in HTTP URI | Blind spots: obfuscated XSS | False positives: legitimate URIs do not contain <img onerror=
alert http any any -> $HOME_NET any (msg:"SERVER-WEBAPP XSS in HTTP URI"; flow:to_server,established; http.uri.raw; content:"<img"; nocase; content:"onerror="; nocase; classtype:web-application-attack; sid:7800020; rev:1;)
# Goal: Detect BIND AUTHORS.BIND reconnaissance query | Blind spots: other BIND info queries | False positives: legitimate clients do not query AUTHORS.BIND
alert dns any any -> $HOME_NET 53 (msg:"DNS BIND authors query attempt"; dns.query; content:"AUTHORS.BIND"; nocase; classtype:attempted-recon; sid:7800021; rev:1;)
# Goal: Detect SIP INVITE with excessively long URI | Blind spots: other SIP overflow parameters | False positives: legitimate SIP URIs are far shorter
alert sip any any -> $HOME_NET any (msg:"SIP INVITE with excessively long URI"; sip.method; content:"INVITE"; nocase; sip.uri; pcre:"/^.{300,}/"; classtype:attempted-admin; sid:7800022; rev:1;)
# Goal: Detect TLS certificate subject containing a null byte | Blind spots: other malformed cert fields | False positives: legitimate certificates do not contain null in CN
alert tls any any -> any any (msg:"TLS certificate subject null byte"; tls.cert_subject; content:"|00|"; classtype:attempted-admin; sid:7800023; rev:1;)
# Goal: Detect SMTP RCPT TO format string | Blind spots: other SMTP format string fields | False positives: legitimate SMTP recipients do not contain %n
alert smtp any any -> $HOME_NET 25 (msg:"SMTP RCPT TO format string attempt"; flow:to_server,established; smtp.rcpt_to; content:"%n"; nocase; classtype:attempted-admin; sid:7800024; rev:1;)
# Goal: Detect SMB NT_CREATE filename fuzzing with repeated punctuation | Blind spots: fuzz strings with alphanumeric content | False positives: legitimate SMB filenames are not punctuation-only
alert tcp any any -> $HOME_NET 445 (msg:"SMB NT_CREATE_ANDX fuzz filename"; flow:to_server,established; pcre:"/(\x28\x00|\x7b\x00|\x7d\x00|\x3e\x00|\x3c\x00|\x3b\x00|\x2a\x00|\x2b\x00|\x2c\x00|\x2d\x00|\x26\x00|\x24\x00|\x60\x00){16,}/"; classtype:attempted-admin; sid:7800026; rev:1;)
