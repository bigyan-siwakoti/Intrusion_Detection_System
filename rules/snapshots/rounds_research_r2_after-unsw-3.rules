# rules/generated/unsw/rounds_research.rules
# AI-authored rules written against the UNSW-NB15 baseline v2, condition: research.

# UNSW-NB15 confirmed: attacker (175.45.176.0/24) enumerates and exfiltrates files
# from FTP servers via directory-traversal RETR/SIZE commands (e.g. "RETR /../../../../../file").
# FTP app-layer events show SIZE -> 213 (file exists) and RETR -> 150/226 (transfer completed).
alert tcp $EXTERNAL_NET any -> $HOME_NET $FTP_PORTS (msg:"UNSW FTP directory traversal file retrieval (RETR ../)"; flow:to_server,established; content:"RETR"; nocase; content:"../"; distance:0; within:64; classtype:attempted-recon; sid:1100001; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET $FTP_PORTS (msg:"UNSW FTP directory traversal file size check (SIZE ../)"; flow:to_server,established; content:"SIZE"; nocase; content:"../"; distance:0; within:64; classtype:attempted-recon; sid:1100002; rev:1;)

# UNSW-NB15 confirmed: attacker (175.45.176.0/24) sends sustained unidirectional
# UDP traffic to RIP port 520 on 149.171.126.12 (629 flows, 2 pkts each, no replies).
# No deployed signature covers this. External UDP to an internal RIP port is
# consistent with route injection / RIP flooding.
alert udp $EXTERNAL_NET any -> $HOME_NET 520 (msg:"UNSW external UDP flood to RIP port 520 (possible route injection/DoS)"; flow:to_server; threshold:type both, track by_src, count 30, seconds 60; classtype:attempted-dos; sid:1100003; rev:1;)

# UNSW-NB15 confirmed: attacker floods internal PPTP server 149.171.126.19:1723
# (151955 bytes in 120 pkts over 3s, only 1426 bytes back). The only signature that
# fired on it was the Siemens WLAN rule (sid:2009976), which is a product mismatch.
alert tcp $EXTERNAL_NET any -> $HOME_NET 1723 (msg:"UNSW PPTP data flood to port 1723"; flow:to_server,established; threshold:type both, track by_src, count 100, seconds 10; classtype:attempted-dos; sid:1100004; rev:1;)

# UNSW-NB15 confirmed: attacker (175.45.176.0/24) harvests mail from internal POP3
# servers (149.171.126.0/24:110). POP3 app-layer events show USER/PASS -> "logged in",
# then LIST/UIDL/RETR 1, all from external hosts. Normal clients (59.166.0.0/24) never
# use POP3 in this capture. Deployed POP3 rules only cover command overflows and rapid
# brute-force connection rates; none covers this slow, successful mail retrieval.
alert tcp $EXTERNAL_NET any -> $HOME_NET 110 (msg:"UNSW external POP3 mail retrieval (RETR)"; flow:to_server,established; app-layer-protocol:pop3; content:"|0d 0a|RETR"; nocase; classtype:attempted-recon; sid:1100005; rev:1;)

# UNSW-NB15 round 10 confirmed: attacker range (175.45.176.0/24) performs SIP
# scanning/fuzzing against internal SIP services (UDP 5060 and 5600). The SIP
# app-layer parser logged 47 events (INVITE/REGISTER/BYE/ACK) but no alert fired:
# PROTOCOL-VOIP inbound INVITE (sid:11968) failed to load because SIP_SERVERS is
# undefined, and the ET INVITE/REGISTER flood rules did not reach their threshold.
# Normal clients (59.166.0.0/24) never use SIP in this capture, so an external
# INVITE/REGISTER to HOME_NET SIP ports is suspicious.
alert udp $EXTERNAL_NET any -> $HOME_NET [5060,5600] (msg:"UNSW external SIP INVITE scan to internal SIP service"; flow:to_server; content:"INVITE"; nocase; depth:12; classtype:attempted-recon; sid:1100006; rev:1;)
alert udp $EXTERNAL_NET any -> $HOME_NET [5060,5600] (msg:"UNSW external SIP REGISTER scan to internal SIP service"; flow:to_server; content:"REGISTER"; nocase; depth:12; classtype:attempted-recon; sid:1100007; rev:1;)

# UNSW-NB15 round 3 confirmed: external attackers (175.45.176.0/24) log into
# internal POP3 servers (149.171.126.0/24:110) with random USER/PASS (all
# "logged in" OK), then LIST/UIDL/RETR 1. 51 RETR commands observed across the
# capture; flows carry up to 429 KB back to the attacker (mail exfiltrated).
# The earlier sid:1100005 rule required CRLF before RETR and never fired.
alert tcp $EXTERNAL_NET any -> $HOME_NET 110 (msg:"UNSW external POP3 mail retrieval (RETR)"; flow:to_server,established; app-layer-protocol:pop3; content:"RETR"; nocase; classtype:attempted-recon; sid:1100008; rev:1;)

# UNSW-NB15 round 3 confirmed: attacker 175.45.176.0 sends a sustained flood of
# DNS queries (2572 ANY queries for "www.exa.dpn") to internal DNS server
# 149.171.126.12 over ~26 minutes, peaking at 326 queries/min. No deployed rule
# covers a high-rate external DNS query flood to HOME_NET DNS servers.
alert udp $EXTERNAL_NET any -> $HOME_NET 53 (msg:"UNSW external DNS query flood to internal DNS server"; flow:to_server; threshold:type both, track by_src, count 100, seconds 60; classtype:attempted-dos; sid:1100009; rev:1;)
