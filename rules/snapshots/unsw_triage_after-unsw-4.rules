# rules/generated/unsw_triage.rules
# Detection rules authored during triage of logs/unsw-3-raw/eve.json (UNSW-NB15 pcap 3).
#
# Confirmed campaigns in this capture (attacker range 175.45.176.0/24):
#   A. FTP weak-password login success against 149.171.126.19:21
#      (59 successful PASS "password" logins; stock rules only saw the USER
#       overflow/fuzz strings, not the successful authentication).
#   B. SMB IPC$ share connect burst from 175.45.176.1 -> 149.171.126.15:445
#      (58 negotiate+tree-connect sessions in ~40s; stock GPL SID 2102466
#       fires per-session but does not consolidate the burst).
#   C. Outbound Windows cmd.exe shell banner from 149.171.126.13 to
#      175.45.176.3:63031 (backdoor listener on :37726; stock ET/GPL rules
#      fired on the banner, this rule re-anchors the HOME_NET -> EXTERNAL_NET
#      direction for the UNSW network model).

# --- A. FTP weak-password login success ------------------------------------
alert tcp $EXTERNAL_NET any -> $HOME_NET 21 ( \
    msg:"CUSTOM FTP weak-password login success - repeated PASS password from external host"; \
    flow:to_server,established; \
    content:"PASS password"; nocase; \
    threshold:type threshold, track by_src, count 5, seconds 120; \
    classtype:attempted-admin; \
    sid:7600201; rev:1;)

# --- B. SMB IPC$ share connect burst ---------------------------------------
# Matches the UTF-16LE or ASCII IPC$ share name inside SMB TREE_CONNECT_ANDX.
alert tcp $EXTERNAL_NET any -> $HOME_NET 445 ( \
    msg:"CUSTOM SMB IPC$ share access burst - SMB enumeration/bruteforce"; \
    flow:to_server,established; \
    pcre:"/I(\x00)?P(\x00)?C(\x00)?\x24/i"; \
    threshold:type threshold, track by_src, count 20, seconds 60; \
    classtype:attempted-recon; \
    sid:7600202; rev:1;)

# --- C. Outbound Windows cmd.exe shell banner ------------------------------
# A HOME_NET host sending the Windows cmd.exe banner to an external host is a
# strong backdoor/reverse-shell indicator (observed 149.171.126.13 -> 175.45.176.3).
alert tcp $HOME_NET any -> $EXTERNAL_NET any ( \
    msg:"CUSTOM Outbound Windows cmd.exe shell banner from internal host (backdoor/reverse shell)"; \
    flow:established; \
    content:"Microsoft Windows"; nocase; \
    content:"Copyright"; nocase; \
    threshold:type limit, track by_src, count 1, seconds 3600; \
    classtype:trojan-activity; \
    sid:7600203; rev:1;)

# --- D. FTP password fuzz/brute-force success (UNSW pcap 1) -----------------
# Confirmed in logs/unsw-1-raw/eve.json:
#   175.45.176.3 -> 149.171.126.18:21
#   59 x "PASS <fuzz-payload>" answered with "230 Login successful." between
#   10:25:38 and 10:29:21. Stock GPL SID 2101972 only fires on the overflow
#   shaped PASS strings; it misses the successful-authentication side entirely.
alert tcp $HOME_NET 21 -> $EXTERNAL_NET any ( \
    msg:"CUSTOM FTP login success burst from external host - password fuzz/brute force"; \
    flow:to_client,established; \
    content:"230 Login successful"; nocase; \
    threshold:type threshold, track by_dst, count 5, seconds 120; \
    classtype:attempted-admin; \
    sid:7600204; rev:1;)

# --- E. Slow SMB IPC$ share sweep (UNSW pcap 1) -----------------------------
# Confirmed in logs/unsw-1-raw/eve.json:
#   175.45.176.1 -> 149.171.126.11:445
#   58 x SMB1 TREE_CONNECT_ANDX to \149.171.126.11\IPC$ between 10:17:09 and
#   10:27:31 (~10 min). SID 7600202 above requires 20/60s (written for the
#   faster pcap-3 burst); this slower sustained enumeration was only caught by
#   the per-session stock rule 2102466.
alert tcp $EXTERNAL_NET any -> $HOME_NET 445 ( \
    msg:"CUSTOM SMB IPC$ share access sustained sweep - SMB enumeration"; \
    flow:to_server,established; \
    pcre:"/I(\x00)?P(\x00)?C(\x00)?\x24/i"; \
    threshold:type threshold, track by_src, count 20, seconds 600; \
    classtype:attempted-recon; \
    sid:7600205; rev:1;)

# --- F. Cisco IOS HTTP server exec probe (UNSW pcap 4) ----------------------
# Confirmed in logs/unsw-4-raw/eve.json:
#   17 requests from 175.45.176.0/24 to 149.171.126.0/24 with URI
#   /level/NN/exec//show (and /level/15/exec/-/buffers/assigned/dump).
#   Stock ET SID 2010623 fired only once, so the campaign was largely invisible.
alert http $EXTERNAL_NET any -> $HOME_NET any ( \
    msg:"CUSTOM Cisco IOS HTTP server command execution probe - /level/NN/exec/"; \
    flow:to_server,established; \
    http.uri; content:"/level/"; pcre:"/\/level\/[0-9]{1,3}\/exec\//i"; \
    classtype:attempted-admin; \
    reference:url,www.cisco.com/c/en/us/support/docs/security/ios-http-server/10111-http.html; \
    sid:7600401; rev:1;)

# --- G. TFTP read request with oversized filename (UNSW pcap 4) --------------
# Confirmed in logs/unsw-4-raw/eve.json:
#   175.45.176.3 -> 149.171.126.19:69 (6 RRQ with 1024-1464 byte filenames),
#   175.45.176.1 -> 149.171.126.14:69 (1 RRQ with 1024 byte filename),
#   175.45.176.0 -> 149.171.126.14:69 (1 RRQ with 256 byte filename).
#   Stock GPL SID 2100518 only flags TFTP WRQ ("Put"); these read-request
#   overflow attempts were not alerted.
alert udp $EXTERNAL_NET any -> $HOME_NET 69 ( \
    msg:"CUSTOM TFTP read request with oversized filename - possible buffer overflow"; \
    content:"|00 01|"; depth:2; \
    pcre:"/[^\x00]{255,}\x00/R"; \
    classtype:attempted-admin; \
    reference:cve,1999-0183; \
    sid:7600402; rev:1;)
