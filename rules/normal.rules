# rules/normal.rules  v0  (15 Aug 2026)
# Normality allowlist + catch-all, written against Monday/run05 composition.
# NOTE: $HOME_NET in the system yaml includes 172.16.0.0/12, which contains the
# CIC attacker (172.16.0.1). $EXTERNAL_NET therefore excludes the attacker and
# MUST NOT be used. Explicit CIDRs throughout.
# SIDs 1000001+ = local range.

# --- ALLOWLIST: protocol-identified normal traffic (~93% of Monday flows) ---
pass dns  any any -> any any (msg:"NORMAL dns";  bypass; sid:1000001; rev:1;)
pass tls  any any -> any any (msg:"NORMAL tls";  bypass; sid:1000002; rev:1;)
pass http any any -> any any (msg:"NORMAL http"; bypass; sid:1000003; rev:1;)

# --- CATCH-ALL: everything the allowlist did not account for ---
alert ip any any -> any any (msg:"CATCHALL unmatched flow"; flow:established; app-layer-protocol:failed; \
    threshold:type limit, track by_flow, count 1, seconds 3600; \
    sid:1000900; rev:1;)
