alert tcp $EXTERNAL_NET any -> $HOME_NET 21 (     msg:"CUSTOM FTP weak-password login success - repeated PASS password from external host";     flow:to_server,established;     content:"PASS password"; nocase;     threshold:type threshold, track by_src, count 5, seconds 120;     classtype:attempted-admin;     sid:7600201; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 445 (     msg:"CUSTOM SMB IPC$ share access burst - SMB enumeration/bruteforce";     flow:to_server,established;     pcre:"/I(\x00)?P(\x00)?C(\x00)?\x24/i";     threshold:type threshold, track by_src, count 20, seconds 60;     classtype:attempted-recon;     sid:7600202; rev:1;)
alert tcp $HOME_NET any -> $EXTERNAL_NET any (     msg:"CUSTOM Outbound Windows cmd.exe shell banner from internal host (backdoor/reverse shell)";     flow:established;     content:"Microsoft Windows"; nocase;     content:"Copyright"; nocase;     threshold:type limit, track by_src, count 1, seconds 3600;     classtype:trojan-activity;     sid:7600203; rev:1;)
alert tcp $HOME_NET 21 -> $EXTERNAL_NET any (     msg:"CUSTOM FTP login success burst from external host - password fuzz/brute force";     flow:to_client,established;     content:"230 Login successful"; nocase;     threshold:type threshold, track by_dst, count 5, seconds 120;     classtype:attempted-admin;     sid:7600204; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 445 (     msg:"CUSTOM SMB IPC$ share access sustained sweep - SMB enumeration";     flow:to_server,established;     pcre:"/I(\x00)?P(\x00)?C(\x00)?\x24/i";     threshold:type threshold, track by_src, count 20, seconds 600;     classtype:attempted-recon;     sid:7600205; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 22 (     msg:"CUSTOM SSH connection burst to HOME_NET SSH server - possible brute-force/scan";     flow:to_server;     flags:S;     threshold:type threshold, track by_src, count 10, seconds 60;     classtype:attempted-recon;     sid:7601001; rev:1;)
alert udp $EXTERNAL_NET any -> $HOME_NET 69 (     msg:"CUSTOM TFTP directory traversal read attempt";     content:"|00 01|"; depth:2;     content:"../"; distance:0; within:200;     classtype:attempted-admin;     sid:7601002; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 21 (     msg:"CUSTOM FTP PASS format-string fuzz campaign";     flow:to_server,established;     content:"PASS "; nocase;     pcre:"/PASS [^\r\n]*%[0-9]*[nsduxp@%]/i";     threshold:type threshold, track by_src, count 5, seconds 120;     classtype:attempted-admin;     sid:7601003; rev:1;)
