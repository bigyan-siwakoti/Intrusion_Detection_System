alert smb $EXTERNAL_NET any -> $HOME_NET 445 (     msg:"CUSTOM SMB IPC$ share-access brute force from external host";     flow:to_server,established;     smb.share; content:"IPC$"; nocase;     threshold:type threshold, track by_src, count 20, seconds 60;     classtype:attempted-user;     sid:7700001; rev:1;)
alert ip $EXTERNAL_NET any -> $HOME_NET 111 (     msg:"CUSTOM RPC portmap sweep - external host hammering portmapper 111";     threshold:type threshold, track by_src, count 30, seconds 120;     classtype:attempted-recon;     sid:7700002; rev:1;)
alert tls $EXTERNAL_NET any -> $HOME_NET any (     msg:"CUSTOM Heartbleed overflow heartbeat exploit attempt (CVE-2014-0160)";     flow:to_server,established;     app-layer-event:tls.overflow_heartbeat;     classtype:attempted-user;     reference:cve,2014-0160; reference:url,heartbleed.com;     sid:7700003; rev:1;)
alert tls $EXTERNAL_NET any -> $HOME_NET any (     msg:"CUSTOM TLS heartbeat/handshake burst to HOME_NET service (Heartbleed recon/exploit precursor)";     flow:to_server,established;     threshold:type threshold, track by_src, count 5, seconds 300;     classtype:attempted-recon;     reference:cve,2014-0160;     sid:7700004; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 21 (     msg:"CUSTOM FTP PASS overflow/brute-force campaign from external host";     flow:to_server,established;     content:"PASS"; nocase;     threshold:type threshold, track by_src, count 10, seconds 60;     classtype:attempted-admin;     sid:7700005; rev:1;)
alert udp $EXTERNAL_NET any -> $HOME_NET 69 (     msg:"CUSTOM TFTP GET passwd attempt from external host";     content:"|00 01|"; depth:2;     content:"passwd"; nocase;     classtype:attempted-admin;     sid:7700006; rev:1;)
alert udp $EXTERNAL_NET any -> $HOME_NET 69 (     msg:"CUSTOM TFTP write (Put) burst from external host";     content:"|00 02|"; depth:2;     threshold:type threshold, track by_src, count 5, seconds 60;     classtype:attempted-admin;     sid:7700007; rev:1;)
alert ip $EXTERNAL_NET any -> $HOME_NET 111 (     msg:"CUSTOM Slow RPC portmap sweep - low-and-slow portmapper enumeration from external host";     threshold:type threshold, track by_src, count 20, seconds 1800;     classtype:attempted-recon;     sid:7700008; rev:1;)
alert smb $EXTERNAL_NET any -> $HOME_NET [139,445] (     msg:"CUSTOM Slow SMB IPC$ share-access sweep from external host";     flow:to_server,established;     smb.share; content:"IPC$"; nocase;     threshold:type threshold, track by_src, count 5, seconds 1800;     classtype:attempted-user;     sid:7700009; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 22 (     msg:"CUSTOM SSH Brute-Force Campaign - sustained connection attempts to HOME_NET SSH";     flow:to_server;     flags:S;     threshold:type threshold, track by_src, count 10, seconds 3600;     classtype:attempted-recon;     sid:7700010; rev:1;)
